{$SITE_DOMAIN} {
    encode gzip zstd
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self' blob: data:; font-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
    handle /api/* {
        request_body {
            max_size 25MB
        }
        reverse_proxy api:8000 {
            # Never trust a client-supplied X-Forwarded-For for rate-limit identity.
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle {
        reverse_proxy web:8080
    }
}
