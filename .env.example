# Copy to backend/.env. These defaults are for local development.
# Generate a stable SECRET_KEY with the PowerShell command in README.md.
ENVIRONMENT=development
STUDYVAULT_DEBUG=false
DATABASE_URL=sqlite:///./studyvault.db
SECRET_KEY=
SEED_DEMO=false

# Private persistent storage and upload limits.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_USER_STORAGE_BYTES=1073741824

# Database-backed throttling for public authentication endpoints.
PUBLIC_AUTH_LIMIT_ENABLED=true
REGISTER_PER_HOUR=12
RECOVERY_PER_HOUR=30
LOGIN_PER_HOUR=120

# Database-backed login throttling.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Production requires true, a public HTTPS URL, and the Resend settings below.
REQUIRE_EMAIL_VERIFICATION=false
PUBLIC_FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production origins must be explicit public HTTPS origins; never use *.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# disabled is the local default. Production requires resend.
# file is an inspectable development/test sink and is rejected in production.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SINK_DIR=./email-sink
