# Copy to .env.production. NEVER commit .env.production or share populated values.
# Use your own domain and verify DNS A/AAAA points at the Docker host.
SITE_DOMAIN=studyvault.example.com
ENVIRONMENT=production
STUDYVAULT_DEBUG=false
SEED_DEMO=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_48_CHAR_RANDOM_SECRET
# Generate a different alphanumeric database secret to avoid URL encoding errors.
POSTGRES_PASSWORD=REPLACE_WITH_48_CHAR_ALPHANUMERIC_PASSWORD
REQUIRE_EMAIL_VERIFICATION=true
PUBLIC_FRONTEND_URL=https://studyvault.example.com
CORS_ORIGINS=https://studyvault.example.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_REAL_PROVIDER_KEY
EMAIL_FROM=StudyVault <accounts@your-verified-domain.example>
PUBLIC_AUTH_LIMIT_ENABLED=true
REGISTER_PER_HOUR=12
RECOVERY_PER_HOUR=30
LOGIN_PER_HOUR=120
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_USER_STORAGE_BYTES=1073741824
